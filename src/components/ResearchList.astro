---
import type { CollectionEntry } from "astro:content";

import { formatBehavioralDate } from "../lib/dates";

export interface Props {
  research: CollectionEntry<"research">[];
}

const { research } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<ol class="research-list" aria-label="Current research">
  {
    research.map((entry) => {
      const formattedDate = formatBehavioralDate(
        entry.data.date,
        entry.data.datePrecision,
      );

      return (
        <li>
          <article class="research-row">
            <div class="research-row__heading">
              <h3>{entry.data.title}</h3>
              <p>
                {entry.data.lab}
                <span aria-hidden="true"> · </span>
                {entry.data.institution}
              </p>
            </div>
            <time datetime={formattedDate.datetime}>
              {formattedDate.visible}
            </time>
            <p class="research-row__summary">{entry.data.summary}</p>
            <a
              href={`${base}/research#${entry.id}`}
              aria-label={`View research: ${entry.data.title}`}
            >
              View research
            </a>
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .research-list {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--border);
    list-style: none;
  }

  .research-list > li {
    border-block-end: 1px solid var(--border);
  }

  .research-row {
    display: grid;
    grid-template-columns:
      minmax(14rem, 0.8fr) minmax(7rem, 0.25fr) minmax(18rem, 1fr)
      auto;
    align-items: start;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m);
  }

  .research-row__heading h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .research-row__heading p,
  .research-row > time {
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 680;
  }

  .research-row__heading p {
    margin-block-start: var(--space-xs);
  }

  .research-row__summary {
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .research-row > a {
    font-weight: 720;
    white-space: nowrap;
  }

  @media (max-width: 64rem) {
    .research-row {
      grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr) auto;
    }

    .research-row > time {
      grid-column: 1;
    }

    .research-row__summary {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .research-row > a {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 44rem) {
    .research-row {
      grid-template-columns: 1fr;
    }

    .research-row > time,
    .research-row__summary,
    .research-row > a {
      grid-column: 1;
      grid-row: auto;
    }

    .research-row__summary {
      margin-block-start: var(--space-xs);
    }
  }
</style>
