---
import type { CollectionEntry } from "astro:content";

import { formatBehavioralDate } from "../lib/dates";
import { availableExternalLinks } from "../lib/external-links";

export interface Props {
  research: CollectionEntry<"research">[];
}

const { research } = Astro.props;
---

<ol class="research-list" aria-label="Research">
  {
    research.map((entry) => {
      const formattedDate = formatBehavioralDate(
        entry.data.date,
        entry.data.datePrecision,
      );
      const links = availableExternalLinks(entry.data.links);

      return (
        <li>
          <article class="research-entry" id={entry.id}>
            <h3>{entry.data.title}</h3>
            <p class="research-entry__affiliation">
              {entry.data.lab}
              <span aria-hidden="true"> · </span>
              {entry.data.institution}
            </p>
            <p class="research-entry__timing">
              <time datetime={formattedDate.datetime}>
                {formattedDate.visible}
              </time>
              <span aria-hidden="true"> · </span>
              {entry.data.status}
            </p>
            <p class="research-entry__summary">{entry.data.summary}</p>
            <p class="research-entry__methods">
              {entry.data.methods.join(" · ")}
            </p>
            {links.length > 0 && (
              <ul
                class="research-entry__links"
                aria-label={`Links for ${entry.data.title}`}
              >
                {links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .research-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .research-list > li + li {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
  }

  .research-entry__affiliation {
    margin-block-start: var(--space-2xs);
    color: var(--ink);
    font-size: var(--step-0);
  }

  .research-entry__timing {
    margin-block-start: 0.15rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .research-entry__summary {
    margin-block-start: var(--space-s);
  }

  .research-entry__methods {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .research-entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: var(--space-s) 0 0;
    padding: 0;
    font-size: var(--step--1);
    list-style: none;
  }
</style>
