---
import { resolveFigureSource, validateFigure } from "../lib/figure";

export interface Props {
  src: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

const { src, alt, caption, width, height } = Astro.props;
validateFigure({ src, alt, caption, width, height });
const resolvedSrc = resolveFigureSource(src, import.meta.env.BASE_URL);
---

<figure class="figure">
  <img src={resolvedSrc} alt={alt} width={width} height={height} loading="lazy" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure {
    margin: var(--space-m) 0;
  }

  img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
  }

  figcaption {
    margin-block-start: var(--space-xs);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
