---
import type { CollectionEntry } from "astro:content";
import { formatBehavioralDate } from "../lib/dates";

export interface Props {
  project: CollectionEntry<"projects">;
  href: string;
  linkLabel?: string;
}

const { project, href, linkLabel = `Explore ${project.data.title}` } = Astro.props;

const formattedDate = formatBehavioralDate(project.data.date, project.data.datePrecision);
---

<article class="project-card">
  <div class="project-card__meta">
    <span>{project.data.status}</span>
    <span aria-hidden="true">·</span>
    <time datetime={formattedDate.datetime}>
      {formattedDate.visible}
    </time>
  </div>
  <h3>{project.data.title}</h3>
  <p class="project-card__summary">{project.data.summary}</p>
  <ul class="project-card__themes" aria-label={`Themes for ${project.data.title}`}>
    {project.data.themes.map((theme) => <li>{theme}</li>)}
  </ul>
  <a class="project-card__link" href={href}>{linkLabel}<span aria-hidden="true"> →</span></a>
</article>

<style>
  .project-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 720;
  }

  h3 {
    margin-block-start: var(--space-s);
    font-size: var(--step-2);
  }

  .project-card__summary {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
  }

  .project-card__themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card__themes li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-muted);
    background: var(--surface-strong);
    font-size: var(--step--1);
  }

  .project-card__link {
    align-self: flex-start;
    margin-block-start: auto;
    padding-block-start: var(--space-m);
    font-weight: 720;
  }

  @media (max-width: 24rem) {
    .project-card {
      padding: var(--space-s);
    }

    h3 {
      font-size: var(--step-1);
      line-height: 1.15;
    }
  }
</style>
