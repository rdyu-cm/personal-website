---
const stages = [
  {
    title: "First-principles data",
    description:
      "Density functional theory provides reference data for potential development in water, nitrate, alkali-cation electrolytes, and the TiH2/electrolyte interface.",
  },
  {
    title: "Learned potentials",
    description:
      "MACE is used to develop machine-learned potentials for the bulk electrolytes and TiH2 interface under study.",
  },
  {
    title: "Molecular simulation",
    description:
      "Molecular dynamics carries the learned description into simulations of electrolyte structure and nitrate interfacial distributions.",
  },
  {
    title: "Physical insight",
    description:
      "The simulated configurations support physical interpretation of the electrochemical interface and the distributions within it.",
  },
];
---

<ol class="research-flow" aria-label="Research workflow">
  {
    stages.map((stage, index) => (
      <li>
        <span class="stage-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <h3>{stage.title}</h3>
        <p>{stage.description}</p>
      </li>
    ))
  }
</ol>

<style>
  .research-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-l);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  .research-flow li {
    position: relative;
    min-width: 0;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--primary);
  }

  .research-flow li:not(:last-child)::after {
    content: "";
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: calc(100% + 0.5rem);
    width: calc(var(--space-l) - 1rem);
    height: 1px;
    background: var(--cobalt-light);
  }

  .stage-index {
    display: block;
    margin-block-end: var(--space-s);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 720;
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  p {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 58rem) {
    .research-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .research-flow li:nth-child(2)::after { display: none; }
  }

  @media (max-width: 34rem) {
    .research-flow {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .research-flow li {
      min-height: 8.5rem;
      padding: 0 0 var(--space-l) 3rem;
      border-block-start: 0;
    }

    .research-flow li:not(:last-child)::after,
    .research-flow li:nth-child(2)::after {
      display: block;
      inset-block-start: 1.75rem;
      inset-inline-start: 0.85rem;
      width: 1px;
      height: calc(100% - 1.25rem);
      background: var(--cobalt-light);
    }

    .research-flow li:last-child::after { display: none; }

    .stage-index {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      width: 1.75rem;
      height: 1.75rem;
      display: grid;
      place-items: center;
      margin: 0;
      border: 1px solid var(--primary);
      border-radius: 999px;
      background: var(--canvas);
      font-size: 0.68rem;
    }
  }
</style>
