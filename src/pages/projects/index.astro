---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import { filterPublicEntries, sortByDateDescending } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toRoute = (path: string) => `${base}${path}` || "/";
const projects = sortByDateDescending(
  filterPublicEntries(await getCollection("projects")),
);
---

<BaseLayout
  title="Projects"
  description="Research project records spanning molecular simulation and electrochemical interfaces."
>
  <header class="projects-hero">
    <div class="container">
      <p class="eyebrow">Research records</p>
      <h1>Projects</h1>
      <p class="lede">
        Public case studies documenting active computational chemical
        engineering research.
      </p>
    </div>
  </header>

  <section class="projects-section" aria-labelledby="project-records-title">
    <div class="container">
      <div class="projects-section__heading">
        <h2 id="project-records-title">Project records</h2>
        <p>
          Methods, current status, and reproducibility information from the
          public record.
        </p>
      </div>
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard
                project={project}
                href={toRoute(`/projects/${project.id}`)}
                linkLabel="Read case study"
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            No public project records are available at this time.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .projects-hero {
    padding-block: var(--space-xl) var(--space-l);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .eyebrow {
    margin-block-end: var(--space-s);
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 720;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .projects-hero .lede {
    margin-block-start: var(--space-m);
  }

  .projects-section {
    padding-block: var(--space-xl);
  }

  .projects-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 0.45fr);
    gap: var(--space-m) var(--space-l);
    align-items: end;
    margin-block-end: var(--space-l);
  }

  .projects-section__heading p,
  .empty-state {
    color: var(--ink-muted);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
  }

  @media (max-width: 42rem) {
    .projects-section__heading {
      grid-template-columns: 1fr;
    }
  }
</style>
