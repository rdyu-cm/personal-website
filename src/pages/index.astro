---
import { getCollection } from "astro:content";

import ProjectCard from "../components/ProjectCard.astro";
import PublicationList from "../components/PublicationList.astro";
import { profile } from "../data/profile";
import { takeFeatured } from "../lib/content";
import { buildPersonJsonLd } from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredProjects = takeFeatured(await getCollection("projects"), 3);
const featuredPublications = takeFeatured(await getCollection("publications"), 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toRoute = (path: string) => `${base}${path}` || "/";
const personJsonLd = buildPersonJsonLd(
  profile,
  Astro.site?.toString() ?? profile.domain,
);

const researchThemes = [
  {
    title: "AI/ML potentials",
    description:
      "Developing machine-learned potentials from first-principles calculations for nitrate-reduction electrolytes and TiH2/electrolyte interfaces.",
  },
  {
    title: "Molecular simulation",
    description:
      "Using molecular dynamics and metadynamics to examine interfacial distributions, conformational states, and free-energy barriers.",
  },
  {
    title: "Chemical questions",
    description:
      "Connecting computation to electrochemical interfaces and biomolecular activation mechanisms.",
  },
];

const currentResearch = [
  {
    id: "rotskoff-protein-representations",
    lab: "Rotskoff Lab",
    institution: "Stanford University · June 2026–present",
  },
  {
    id: "nitrate-reduction-electrolytes",
    lab: "Fong Lab",
    institution: "Caltech · December 2024–present",
  },
  {
    id: "smoothened-gi",
    lab: "Goddard Lab",
    institution: "Caltech · December 2023–present",
    supplement: "Simulations use GROMACS and PLUMED.",
  },
].flatMap((record) => {
  const project = featuredProjects.find((entry) => entry.id === record.id);
  return project ? [{ ...record, project }] : [];
});
---

<BaseLayout title={profile.name} description={profile.shortBio} jsonLd={personJsonLd}>
  <section class="home-hero">
    <div class="container home-hero__inner">
      <ul class="hero-tags" aria-label="Research areas">
        <li>AI for science</li>
        <li>Molecular simulation</li>
      </ul>
      <h1>{profile.name}</h1>
      <p class="hero-thesis">
        Interpretable protein representations, machine-learned potentials, and
        molecular mechanisms.
      </p>
      <a class="button button--secondary" href={toRoute("/research")}>
        Explore current research
      </a>
    </div>
  </section>

  <section
    class="current-research"
    aria-labelledby="current-research-title"
  >
    <div class="container">
      <div class="section-heading section-heading--split">
        <h2 id="current-research-title">Current Research</h2>
        <p>
          Three complementary routes from representation and simulation to
          mechanism.
        </p>
      </div>
      <div class="research-row-list">
        {
          currentResearch.map(({ project, lab, institution, supplement }) => (
            <article class="research-row">
              <div>
                <h3>{lab}</h3>
                <p class="research-row__meta">{institution}</p>
              </div>
              <p>
                {project.data.summary}
                {supplement && ` ${supplement}`}
              </p>
              <a href={toRoute(`/research#${project.id}`)}>
                View research<span class="sr-only"> in the {lab}</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section research-interests" aria-labelledby="research-interests-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="research-interests-title">Research interests</h2>
        <p>
          Computational chemical engineering across learned representations,
          molecular-scale dynamics, and physically grounded interpretation.
        </p>
      </div>
      <dl class="theme-list">
        {
          researchThemes.map((theme) => (
            <div>
              <dt>{theme.title}</dt>
              <dd>{theme.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="home-section selected-work" aria-labelledby="selected-work-title">
        <div class="container">
          <div class="section-heading section-heading--split">
            <h2 id="selected-work-title">Selected projects</h2>
            <p>Current research spanning electrochemical and biomolecular systems.</p>
          </div>
          <div class="project-list">
            {featuredProjects.map((project) => (
              <ProjectCard
                project={project}
                href={toRoute(`/research#${project.id}`)}
                linkLabel={`Explore ${project.data.title}`}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredPublications.length > 0 && (
      <section class="home-section outputs" aria-labelledby="outputs-title">
        <div class="container">
          <div class="section-heading section-heading--split">
            <h2 id="outputs-title">Research outputs</h2>
            <p>Public manuscripts and related research records.</p>
          </div>
          <PublicationList publications={featuredPublications} />
        </div>
      </section>
    )
  }

  {
    profile.links.length > 0 && (
      <section class="contact-band" aria-labelledby="contact-title">
        <div class="container contact-band__inner">
          <div>
            <h2 id="contact-title">Contact</h2>
            <p>For research correspondence or code, use the public channels below.</p>
          </div>
          <ul aria-label="Contact links">
            {profile.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .home-hero__inner {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-m);
    padding: 0;
    list-style: none;
  }

  .hero-tags li {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--primary);
    border-radius: 999px;
    color: var(--primary-strong);
    background: color-mix(in oklch, var(--primary) 18%, var(--surface));
    font-weight: 680;
  }

  .hero-tags li:nth-child(2) {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, var(--surface));
  }

  .hero-thesis {
    max-width: 42rem;
    margin-block-start: var(--space-m);
    font-size: var(--step-2);
    font-weight: 660;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .home-hero .button { margin-block-start: var(--space-m); }

  .current-research,
  .home-section {
    padding-block: var(--space-xl);
  }

  .current-research {
    border-block-end: 1px solid var(--border);
    background: var(--canvas);
  }

  .research-interests, .outputs { background: var(--canvas); }

  .selected-work {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .section-heading { margin-block-end: var(--space-l); }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
  }

  .section-heading p {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
  }

  .section-heading--split p {
    max-width: 32rem;
    margin-block-start: 0;
  }

  .research-row-list {
    border-block-start: 1px solid var(--border);
  }

  .research-row {
    display: grid;
    grid-template-columns: minmax(11rem, 0.34fr) minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-s) var(--space-l);
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--border);
  }

  .research-row h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .research-row__meta {
    margin-block-start: var(--space-xs);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .research-row > p {
    max-width: 50rem;
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .research-row > a {
    font-weight: 720;
    white-space: nowrap;
  }

  .theme-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--border);
  }

  .theme-list > div {
    min-width: 0;
    padding: var(--space-m);
  }

  .theme-list > div + div { border-inline-start: 1px solid var(--border); }

  .theme-list dt {
    font-size: var(--step-1);
    font-weight: 740;
  }

  .theme-list dd {
    margin: var(--space-s) 0 0;
    color: var(--ink-muted);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
  }

  .contact-band {
    padding-block: var(--space-xl);
    color: var(--canvas);
    background: var(--primary-strong);
  }

  .contact-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
  }

  .contact-band h2 {
    color: var(--canvas);
    font-size: var(--step-2);
  }

  .contact-band p {
    margin-block-start: var(--space-xs);
    color: var(--surface-strong);
  }

  .contact-band ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-band a {
    color: var(--canvas);
    font-weight: 720;
    text-decoration-color: var(--primary);
  }

  @media (max-width: 48rem) {
    .research-row {
      grid-template-columns: 1fr;
    }

    .section-heading--split,
    .contact-band__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .theme-list { grid-template-columns: 1fr; }

    .theme-list > div {
      padding-inline: 0;
      border-block-end: 1px solid var(--border);
    }

    .theme-list > div + div { border-inline-start: 0; }
  }

  @media (max-width: 24rem) {
    .hero-thesis { font-size: var(--step-1); }
  }
</style>
