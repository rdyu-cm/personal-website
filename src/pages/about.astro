---
import { profile } from "../data/profile";
import { buildPersonJsonLd } from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const personJsonLd = buildPersonJsonLd(profile);

---

<BaseLayout title="About" description={profile.shortBio} jsonLd={personJsonLd}>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Researcher profile</p>
      <h1>About Ryan Yu</h1>
    </div>
  </section>

  <section class="page-content">
    <div class="container prose">
      <h2>Trajectory</h2>
      {profile.longBio.map((paragraph) => <p>{paragraph}</p>)}

      <h2>Methods and questions</h2>
      <p>
        Ryan’s work combines first-principles data, machine-learning potentials,
        molecular dynamics, and metadynamics to connect molecular-scale behavior
        with physical insight. Current questions span electrochemical interfaces,
        nitrate-reduction electrolytes, TiH2/electrolyte interfaces, and
        biomolecular activation mechanisms.
      </p>

      <h2>Research appointments</h2>
      <dl>
        <div><dt>Goddard Lab</dt><dd>2023–present</dd></div>
        <div><dt>Fong Lab</dt><dd>2024–present</dd></div>
        <div><dt>VOC/LSER project</dt><dd>2025</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header, .page-content { padding-block: var(--space-xl); }
  .page-header { border-block-end: 1px solid var(--border); background: var(--surface); }
  .eyebrow { color: var(--primary-strong); font-size: var(--step--1); font-weight: 720; letter-spacing: 0.08em; text-transform: uppercase; }
  h2 { margin-block: var(--space-l) var(--space-s); }
  h2:first-child { margin-block-start: 0; }
  dl { margin: var(--space-m) 0 0; border-block-start: 1px solid var(--border); }
  dl div { display: flex; justify-content: space-between; gap: var(--space-m); padding-block: var(--space-s); border-block-end: 1px solid var(--border); }
  dt { font-weight: 720; }
  dd { margin: 0; color: var(--ink-muted); }
</style>
