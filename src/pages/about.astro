---
import { getCollection, render } from "astro:content";

import { profile } from "../data/profile";
import { buildPersonJsonLd } from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const [about] = await getCollection("about");
if (!about) throw new Error("Expected src/content/about/about.md");
const { Content } = await render(about);
const personJsonLd = buildPersonJsonLd(
  profile,
  Astro.site?.toString() ?? profile.domain,
);
---

<BaseLayout title="About" description={profile.shortBio} jsonLd={personJsonLd}>
  <section class="page-content">
    <div class="container prose">
      <article aria-label={about.data.title}>
        <h1>{about.data.title}</h1>
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .page-content {
    padding-block: var(--space-l);
  }

  article {
    max-width: var(--prose-width);
  }

  h1 {
    margin-block-end: var(--space-l);
  }
</style>
