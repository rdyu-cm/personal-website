---
import { getCollection } from "astro:content";

import PublicationList from "../components/PublicationList.astro";
import {
  canFilterPublications,
  filterPublicEntries,
  publicationFilterOptions,
  sortByDateDescending,
} from "../lib/content";
import {
  buildScholarlyArticleJsonLd,
  publicationFragmentId,
} from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = sortByDateDescending(
  filterPublicEntries(await getCollection("publications")),
);
const publicationsByYear = Map.groupBy(publications, (publication) =>
  publication.data.date.getUTCFullYear(),
);
const years = [...publicationsByYear.keys()].sort((a, b) => b - a);
const filterDimension = "type";
const filterOptions = publicationFilterOptions(publications, filterDimension);
const showFilter = canFilterPublications(publications, filterDimension);
const publicationsUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
const scholarlyJsonLd = publications.flatMap((publication) => {
  const canonicalUrl = new URL(publicationsUrl);
  canonicalUrl.hash = publicationFragmentId(publication.id);
  const jsonLd = buildScholarlyArticleJsonLd(
    publication,
    canonicalUrl.toString(),
  );
  return jsonLd ? [jsonLd] : [];
});
---

<BaseLayout
  title="Publications & Presentations"
  description="Publications and presentations by Ryan Yu."
  jsonLd={scholarlyJsonLd.length > 0 ? scholarlyJsonLd : undefined}
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Selected scholarship</p>
      <h1>Publications &amp; Presentations</h1>
      <p class="lede">Published scholarship and presentations, organized by year.</p>
    </div>
  </section>

  {
    showFilter && (
      <section class="publication-filter" aria-label="Filter publications">
        <div class="container">
          <label for="publication-filter">
            Filter by type
            <select id="publication-filter" data-publication-filter>
              <option value="all">All</option>
              {filterOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </label>
        </div>
      </section>
    )
  }

  <section class="page-content" aria-label="Publications by year">
    <div class="container">
      {
        years.map((year) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <PublicationList
              publications={publicationsByYear.get(year) ?? []}
            />
          </section>
        ))
      }
    </div>
  </section>
  <script>
    const filter = document.querySelector<HTMLSelectElement>(
      "[data-publication-filter]",
    );
    import { normalizePublicationType } from "../lib/content";

    filter?.addEventListener("change", () => {
      const selectedType = normalizePublicationType(filter.value);
      const publications = document.querySelectorAll<HTMLElement>(
        "[data-publication-type]",
      );

      publications.forEach((publication) => {
        publication.hidden =
          selectedType !== "all" &&
          normalizePublicationType(
            publication.dataset.publicationType ?? "",
          ) !== selectedType;
      });
      document.querySelectorAll<HTMLElement>(".year-group").forEach((group) => {
        group.hidden = !group.querySelector(
          "[data-publication-type]:not([hidden])",
        );
      });
    });
  </script>
</BaseLayout>

<style>
  .page-header,
  .page-content {
    padding-block: var(--space-l);
  }
  .page-header {
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }
  .eyebrow {
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lede {
    margin-block-start: var(--space-m);
    color: var(--ink-muted);
    font-size: var(--step-1);
  }
  .publication-filter {
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--border);
  }
  .publication-filter label {
    display: grid;
    gap: var(--space-2xs);
    max-width: 18rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-weight: 680;
  }
  .publication-filter select {
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    padding: var(--space-2xs) var(--space-xs);
  }
  .year-group + .year-group {
    margin-block-start: var(--space-xl);
  }
  .year-group h2 {
    margin-block-end: var(--space-m);
    font-size: var(--step-2);
  }
</style>
