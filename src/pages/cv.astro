---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Curriculum vitae"
  description="An HTML summary of Ryan Yu’s education, research, and methods."
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Curriculum vitae</p>
      <h1>Curriculum vitae</h1>
      <p class="lede">A concise HTML summary. A résumé is available on request.</p>
    </div>
  </section>

  <section class="page-content">
    <div class="container prose">
      <h2>Education</h2>
      <p><strong>California Institute of Technology</strong><br />Chemical Engineering (Computational), undergraduate, 2023–2027</p>

      <h2>Research experience</h2>
      <dl>
        <div><dt>Goddard Lab</dt><dd>2023–present</dd></div>
        <div><dt>Fong Lab</dt><dd>2024–present</dd></div>
        <div><dt>VOC/LSER project</dt><dd>2025</dd></div>
      </dl>

      <h2>Methods</h2>
      <p>
        First-principles data, machine-learning potentials, molecular dynamics,
        metadynamics, and data-science modeling for molecular and interfacial systems.
      </p>

      <h2>Contact</h2>
      <p><a href="mailto:rdyu@caltech.edu">Email Ryan Yu</a> for a résumé or research correspondence.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header, .page-content { padding-block: var(--space-xl); }
  .page-header { border-block-end: 1px solid var(--border); background: var(--surface); }
  .eyebrow { color: var(--primary-strong); font-size: var(--step--1); font-weight: 720; letter-spacing: 0.08em; text-transform: uppercase; }
  .lede { margin-block-start: var(--space-m); color: var(--ink-muted); font-size: var(--step-1); }
  h2 { margin-block: var(--space-l) var(--space-s); }
  h2:first-child { margin-block-start: 0; }
  dl { margin: 0; border-block-start: 1px solid var(--border); }
  dl div { display: flex; justify-content: space-between; gap: var(--space-m); padding-block: var(--space-s); border-block-end: 1px solid var(--border); }
  dt { font-weight: 720; }
  dd { margin: 0; color: var(--ink-muted); }
</style>
