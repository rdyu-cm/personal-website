---
import { getCollection, render } from "astro:content";

import ResearchFlow from "../components/ResearchFlow.astro";
import { profile } from "../data/profile";
import { takeFeatured } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = takeFeatured(await getCollection("projects"), 3);
const orderedTracks = [
  "rotskoff-protein-representations",
  "nitrate-reduction-electrolytes",
  "smoothened-gi",
].flatMap((id) => {
  const project = projects.find((entry) => entry.id === id);
  return project ? [project] : [];
});
const renderedTracks = await Promise.all(
  orderedTracks.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
  })),
);
---

<BaseLayout
  title="Research"
  description={`The research workflow and current computational chemical engineering projects of ${profile.name}.`}
>
  <header class="research-hero">
    <div class="container research-hero__grid">
      <h1>From first-principles data to physical insight</h1>
      <div>
        <p class="research-lede">
          I study interpretable protein representations, electrochemical interfaces,
          and biomolecular mechanisms with machine learning and molecular simulation.
        </p>
        <p>
          The common thread is a scientific workflow that connects the quality of
          the underlying description to the physical interpretation of a simulation.
        </p>
      </div>
    </div>
  </header>

  <section class="flow-section" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="flow-title">A data-to-insight workflow</h2>
        <p>
          In the nitrate-reduction work, first-principles calculations support learned
          potentials, which extend molecular simulation toward interfacial questions.
        </p>
      </div>
      <ResearchFlow />
      <p class="validation-note">
        Validation closes the modeling loop in a separate 2025 VOC/LSER data-science
        project, where I used molecule-similarity testing and model validation.
      </p>
    </div>
  </section>

  <div class="research-tracks">
    {
      renderedTracks.map(({ project, Content }, index) => (
        <section
          class:list={[
            "research-track",
            { "research-track--alternate": index % 2 === 1 },
          ]}
          id={project.id}
          aria-labelledby={`${project.id}-title`}
        >
          <div class="container research-track__grid">
            <div class="track-heading">
              <p>{project.data.status}</p>
              <h2 id={`${project.id}-title`}>{project.data.title}</h2>
            </div>
            <div class="track-copy">
              <p>{project.data.summary}</p>
              <Content />
              <ul aria-label={`${project.data.title} research themes`}>
                {project.data.themes.map((theme) => <li>{theme}</li>)}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .research-hero {
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .research-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    align-items: end;
    gap: var(--space-l) var(--space-xl);
  }

  .research-hero h1 { max-width: 13ch; }

  .research-lede {
    font-size: var(--step-1);
    font-weight: 680;
    line-height: 1.4;
  }

  .research-lede + p { color: var(--ink-muted); }
  .flow-section,
  .research-track {
    padding-block: var(--space-l);
  }
  .flow-section { border-block-end: 1px solid var(--border); }
  .validation-note { max-width: var(--prose-width); margin-block-start: var(--space-l); color: var(--ink-muted); }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(18rem, 0.5fr);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
  }

  .section-heading p,
  .track-copy p + p { color: var(--ink-muted); }

  .section-heading h2 {
    font-size: var(--step-2);
  }

  .research-track { scroll-margin-block-start: var(--space-m); }

  .research-track--alternate {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .research-track__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-l) var(--space-xl);
  }

  .track-heading p {
    margin-block-end: var(--space-s);
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 740;
  }

  .track-heading h2 {
    font-size: var(--step-2);
  }

  .track-copy {
    max-width: var(--prose-width);
    padding-block-start: var(--space-xs);
  }

  .track-copy > p:first-child {
    font-size: var(--step-1);
    font-weight: 660;
    line-height: 1.4;
  }

  .track-copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .track-copy li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-muted);
    background: var(--canvas);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .research-hero__grid,
    .section-heading,
    .research-track__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 24rem) {
    .research-hero h1 {
      font-size: var(--step-3);
      line-height: 1.08;
    }

    .track-heading h2 {
      font-size: var(--step-1);
      line-height: 1.2;
    }
  }
</style>
