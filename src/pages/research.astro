---
import { getCollection } from "astro:content";

import ResearchFlow from "../components/ResearchFlow.astro";
import { profile } from "../data/profile";
import { takeFeatured } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = takeFeatured(await getCollection("projects"), 3);
const nitrateProject = projects.find(
  (project) => project.id === "nitrate-reduction-electrolytes",
);
const smoothenedProject = projects.find((project) => project.id === "smoothened-gi");
---

<BaseLayout
  title="Research"
  description={`The research workflow and current computational chemical engineering projects of ${profile.name}.`}
>
  <header class="research-hero">
    <div class="container research-hero__grid">
      <h1>From first-principles data to physical insight</h1>
      <div>
        <p class="research-lede">
          I study electrochemical and biomolecular questions with AI/ML potentials,
          molecular dynamics, and metadynamics.
        </p>
        <p>
          The common thread is a scientific workflow that connects the quality of
          the underlying description to the physical interpretation of a simulation.
        </p>
      </div>
    </div>
  </header>

  <section class="flow-section" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="flow-title">A data-to-insight workflow</h2>
        <p>
          In the nitrate-reduction work, first-principles calculations support learned
          potentials, which extend molecular simulation toward interfacial questions.
        </p>
      </div>
      <ResearchFlow />
    </div>
  </section>

  <div class="research-tracks">
    {
      nitrateProject && (
        <section
          class="research-track"
          id="nitrate-reduction-electrolytes"
          aria-labelledby="nitrate-title"
        >
          <div class="container research-track__grid">
            <div class="track-heading">
              <p>{nitrateProject.data.status}</p>
              <h2 id="nitrate-title">{nitrateProject.data.title}</h2>
            </div>
            <div class="track-copy">
              <p>{nitrateProject.data.summary}</p>
              <p>
                In the Fong Lab, I use MACE, molecular dynamics, and density functional
                theory to develop a machine-learned potential for water, nitrate, and
                alkali-cation bulk electrolytes. I am also developing a potential for
                the TiH2/electrolyte interface to study nitrate interfacial distributions.
              </p>
              <ul aria-label="Nitrate-reduction research themes">
                {nitrateProject.data.themes.map((theme) => <li>{theme}</li>)}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    {
      smoothenedProject && (
        <section
          class="research-track research-track--alternate"
          id="smoothened-gi"
          aria-labelledby="smoothened-title"
        >
          <div class="container research-track__grid">
            <div class="track-heading">
              <p>{smoothenedProject.data.status}</p>
              <h2 id="smoothened-title">{smoothenedProject.data.title}</h2>
            </div>
            <div class="track-copy">
              <p>{smoothenedProject.data.summary}</p>
              <p>
                In the Goddard Lab, I use GROMACS and PLUMED for molecular dynamics
                and metadynamics simulations of Smoothened/Gi. The work identified a
                precoupled inactive Smoothened–closed Gi state, investigated its
                free-energy barrier, and contributed to a submitted study of ligand
                activation.
              </p>
              <ul aria-label="Smoothened research themes">
                {smoothenedProject.data.themes.map((theme) => <li>{theme}</li>)}
              </ul>
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .research-hero {
    padding-block: var(--space-xl);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .research-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    align-items: end;
    gap: var(--space-l) var(--space-xl);
  }

  .research-hero h1 { max-width: 13ch; }

  .research-lede {
    font-size: var(--step-1);
    font-weight: 680;
    line-height: 1.4;
  }

  .research-lede + p { color: var(--ink-muted); }
  .flow-section, .research-track { padding-block: var(--space-xl); }
  .flow-section { border-block-end: 1px solid var(--border); }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(18rem, 0.5fr);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
  }

  .section-heading p,
  .track-copy p + p { color: var(--ink-muted); }

  .research-track { scroll-margin-block-start: var(--space-m); }

  .research-track--alternate {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .research-track__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-l) var(--space-xl);
  }

  .track-heading p {
    margin-block-end: var(--space-s);
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 740;
  }

  .track-heading h2 { font-size: var(--step-2); }

  .track-copy {
    max-width: var(--prose-width);
    padding-block-start: var(--space-xs);
  }

  .track-copy > p:first-child {
    font-size: var(--step-1);
    font-weight: 660;
    line-height: 1.4;
  }

  .track-copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .track-copy li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-muted);
    background: var(--canvas);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .research-hero__grid,
    .section-heading,
    .research-track__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 24rem) {
    .research-hero h1 {
      font-size: var(--step-3);
      line-height: 1.08;
    }

    .track-heading h2 {
      font-size: var(--step-1);
      line-height: 1.2;
    }
  }
</style>
