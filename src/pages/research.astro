---
import { getCollection, render } from "astro:content";

import { profile } from "../data/profile";
import { filterPublicEntries, sortByDateDescending } from "../lib/content";
import { formatBehavioralDate } from "../lib/dates";
import BaseLayout from "../layouts/BaseLayout.astro";

const research = sortByDateDescending(
  filterPublicEntries(await getCollection("research")),
);
const renderedResearch = await Promise.all(
  research.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout
  title="Research"
  description={`Current computational chemical engineering research by ${profile.name}.`}
>
  <header class="research-hero">
    <div class="container">
      <p class="eyebrow">Research appointments</p>
      <h1>Research</h1>
      <p class="lede">
        Interpretable protein representations, electrochemical interfaces, and
        biomolecular mechanisms using machine learning and molecular simulation.
      </p>
    </div>
  </header>

  <section class="research-section" aria-label="Research appointments">
    <div class="container">
      <div class="research-list">
        {
          renderedResearch.map(({ entry, Content }) => {
            const date = formatBehavioralDate(
              entry.data.date,
              entry.data.datePrecision,
            );
            return (
              <article class="research-entry" id={entry.id}>
                <div class="research-entry__metadata">
                  <p>{entry.data.status}</p>
                  <p>{entry.data.lab}</p>
                  <p>{entry.data.institution}</p>
                  <time datetime={date.datetime}>{date.visible}</time>
                </div>
                <div class="research-entry__content">
                  <h2>{entry.data.title}</h2>
                  <p class="research-entry__summary">{entry.data.summary}</p>
                  <Content />
                  <h3>Methods</h3>
                  <ul aria-label={`${entry.data.title} methods`}>
                    {entry.data.methods.map((method) => (
                      <li>{method}</li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-hero {
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .eyebrow {
    margin-block-end: var(--space-s);
    color: var(--primary-strong);
    font-size: var(--step--1);
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lede {
    max-width: var(--prose-width);
    margin-block-start: var(--space-m);
    font-size: var(--step-1);
    font-weight: 680;
    line-height: 1.4;
  }

  .research-section {
    padding-block: var(--space-l);
  }

  .research-list {
    border-block-start: 1px solid var(--border);
  }

  .research-entry {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.25fr);
    gap: var(--space-l) var(--space-xl);
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--border);
    scroll-margin-block-start: var(--space-m);
  }

  .research-entry__metadata {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .research-entry__metadata p:first-child {
    margin-block-end: var(--space-s);
    color: var(--primary-strong);
    font-weight: 740;
  }

  .research-entry__metadata p + p {
    margin-block-start: var(--space-2xs);
  }

  .research-entry__metadata time {
    display: block;
    margin-block-start: var(--space-s);
  }

  .research-entry__content {
    max-width: var(--prose-width);
  }

  .research-entry__content h2 {
    font-size: var(--step-2);
  }

  .research-entry__summary {
    margin-block: var(--space-s);
    font-size: var(--step-1);
    font-weight: 660;
    line-height: 1.4;
  }

  .research-entry__content h3 {
    margin-block: var(--space-m) var(--space-s);
    font-size: var(--step-0);
  }

  .research-entry__content ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .research-entry__content li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-muted);
    background: var(--canvas);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .research-entry {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 24rem) {
    .research-entry__content h2 {
      font-size: var(--step-1);
      line-height: 1.2;
    }
  }
</style>
