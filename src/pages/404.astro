---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toRoute = (path: string) => `${base}${path}` || "/";
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found">
    <div class="container prose">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The page you requested is unavailable or may have moved.</p>
      <nav aria-label="Suggested destinations">
        <ul role="list">
          <li><a href={toRoute("/")}>Home</a></li>
          <li><a href={toRoute("/research")}>Research</a></li>
          <li>
            <a href={toRoute("/publications")}>Publications &amp; Presentations</a>
          </li>
          <li><a href={toRoute("/about")}>About</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 58vh; display: grid; align-items: center; padding-block: var(--space-xl); }
  .eyebrow { color: var(--primary-strong); font-size: var(--step--1); font-weight: 720; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin-block: var(--space-s) var(--space-m); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-s) var(--space-m); margin: var(--space-m) 0 0; padding: 0; list-style: none; font-weight: 720; }
</style>
